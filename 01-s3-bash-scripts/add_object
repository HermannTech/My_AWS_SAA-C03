#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/config.sh"

BUCKET_NAME="${1:?Usage: ./add_object <bucket> <file>}"
FILE="${2:?Usage: ./add_object <bucket> <file>}"

[ -f "$FILE" ] || { echo "File not found: $FILE"; exit 1; }
aws s3api put-object --bucket "$BUCKET_NAME" --key "$(basename "$FILE")" --body "$FILE"
echo "Uploaded $FILE to $BUCKET_NAME"